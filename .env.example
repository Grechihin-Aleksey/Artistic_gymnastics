# Токен секретариата, не короче 16 символов
ADMIN_TOKEN=change-me-to-a-long-random-string
# Ключ лицензии (необязательно здесь: его можно вставить в секретариате, блок «Лицензия»)
LICENSE_KEY=
# Результаты на сайте (необязательно): адрес облачного ретранслятора и его токен
RELAY_URL=
RELAY_TOKEN=
# Кнопка «Подключить к сайту» (сайт федерации на теме ag-federation, необязательно):
# пользователь WordPress и его пароль приложения; WP_URL нужен, только если сайт не там, где ретранслятор
WP_URL=
WP_USER=
WP_APP_PASSWORD=
# Копия базы и турниров в облачное хранилище S3 (необязательно), например Beget:
# адрес хранилища, имя бакета и ключи доступа из панели хранилища
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Ключ GitHub для Обновить.bat, если репозиторий программы закрытый (только чтение)
GITHUB_TOKEN=
